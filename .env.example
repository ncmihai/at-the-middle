# midspot — environment variables (canonical names, NO secret values in the repo).
# Real values live ONLY in Infisical (project midspot-prod, env prod); this file is a
# template for local development. `.env*` is gitignored (except this example) and is
# never rsynced to the box.
#
# Canonical source: docs/flight-data-spec.md §8. Read env LAZILY (inside functions, not
# at module top level) so `next build` works without secrets.
# Server-only secrets must NEVER be prefixed NEXT_PUBLIC_*.
#
# PORT / HOSTNAME / NODE_ENV are NOT set here — they come from the systemd unit
# (ops/midspot-web.service): PORT=3005, HOSTNAME=127.0.0.1, NODE_ENV=production.

# --- Core infra ---
# Local/dev default; on the box this is the self-hosted Postgres (ops/midspot-postgres.compose.yml):
DATABASE_URL=postgres://midspot:change-me@127.0.0.1:5433/midspot
# Baked into the client bundle at build time (set in the CI build env from Infisical):
NEXT_PUBLIC_SITE_URL=https://midspot.ncmihai.dev

# --- Flight provider selection ---
# tequila | travelpayouts-data | duffel | serpapi | mock
FLIGHTS_PROVIDER=tequila

# --- Kiwi Tequila (server-only) ---
KIWI_TEQUILA_API_KEY=
KIWI_TEQUILA_BASE_URL=https://tequila-api.kiwi.com

# --- Travelpayouts Data API / Links API / affiliate links (server-only) ---
TRAVELPAYOUTS_API_KEY=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_TRS=
TRAVELPAYOUTS_SUB_ID=midspot
TRAVELPAYOUTS_KIWI_PROMO_ID=3791

# --- Duffel (server-only; test mode for dev) ---
DUFFEL_ACCESS_TOKEN=
DUFFEL_MODE=test

# --- SerpApi (server-only; last-resort fallback) ---
SERPAPI_API_KEY=

# --- Cache, caps, TTLs (canonical values from flight-data-spec §7.3) ---
FLIGHTS_CACHE_TTL_SECONDS=1800
AIRPORT_CACHE_TTL_DAYS=30
FLIGHTS_MAX_CANDIDATE_DESTINATIONS=30
FLIGHTS_MAX_WINDOW_DAYS=14
FLIGHTS_MAX_ORIGINS=8
FLIGHTS_TOP_K_DEEP_SEARCH=10
FLIGHTS_MAX_CONCURRENCY=4
FLIGHTS_ARRIVAL_GAP_LIMIT_HOURS=24
FLIGHTS_ARRIVAL_GAP_RELAXED_HOURS=30

# --- Rate limits (per IP) ---
RATE_LIMIT_PER_MIN=240
RATE_LIMIT_SEARCH_PER_MIN=5
RATE_LIMIT_AIRPORTS_PER_MIN=30

# --- Retention ---
SEARCH_RETENTION_DAYS=7

# --- Ads (public, baked at build; disabled until ad accounts are approved) ---
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ETHICALADS_ID=
NEXT_PUBLIC_CARBONADS_SERVE_ID=
